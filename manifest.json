{
  "manifest_version": 3,
  "name": "SmartReply AI",
  "version": "1.0",
  "description": "AI chat and email reply assistant",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "https://api.sarvam.ai/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "src/popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.jsx"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}